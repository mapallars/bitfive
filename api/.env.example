APP_NAME=Bitfive DevOpsProject API
VERSION=1.0.0
VERSIONING=/api/v1
PORT=3000
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<db>
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bitfive
JWT_SECRET=secret_key
JWT_EXPIRES_IN=30d

# Redis (requerido por BullMQ para la cola de correos)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP — Brevo (https://app.brevo.com → Settings → SMTP & API)
# Usar smtp-relay.sendinblue.com (alias legacy) 
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=<login-brevo>
SMTP_PASS=<api-key-smtp-brevo>
SMTP_FROM=<remitente-verificado-en-brevo>